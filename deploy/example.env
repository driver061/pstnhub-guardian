# /home/user/squad/PSTN/git/pstnhub-guardian/<instance>.env    chmod 0600, chown squad-gatekeeper
# Lives in the checkout, NOT /etc. It holds the webhook secret — .gitignore has
# *.env; do not remove that line.
#
# Copy per server, e.g.:
#   /home/user/squad/PSTN/git/pstnhub-guardian/main.env     -> systemctl enable --now squad-gatekeeper@main
#   /home/user/squad/PSTN/git/pstnhub-guardian/server2.env  -> systemctl enable --now squad-gatekeeper@server2

# --- the webhook. THIS is the only place the secret goes. Never a flag. -------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# --- nftables table, MUST be unique per instance -----------------------------
# Two instances sharing a table name will fight over the same chain and one will
# gate the other's port. Name it after the instance.
NFT_TABLE=squad_main

# --- ports + log path --------------------------------------------------------
# CONFIRM THE PORTS FIRST — these are placeholders:  ss -ulpn | grep SquadGame
# Only -game-port is gated; beacon and query are always accepted.
# The log path is a PATTERN SEED, not a fixed file: SquadGame.log also matches
# SquadGame_2.log etc, and the newest-written one is followed automatically.
# Add -enforce to this line only after a clean log-only week.
# Keep the double quotes: systemd strips them, and deploy/run.sh needs them to
# source this file with plain sh.
GATEKEEPER_ARGS="-log /home/squad/SquadGame/Saved/Logs/SquadGame.log -game-port 7787 -beacon-port 15000 -query-port 27165"
